async function main() {
  for (const loc of Object.keys(patches)) {
    const fileUrl = pathToFileURL(path.resolve(`src/shared/i18n/${loc}.ts`)).href;
    const mod = await import(fileUrl);
    const data = structuredClone(mod[loc]);
    Object.assign(data.punto, patches[loc]);
    // also sync palette new groups if missing
    if (!data.palette.glagolitic) data.palette.glagolitic = patches[loc] ? undefined : undefined;
    const out = `import type { Messages } from "./en";\n\nexport const ${loc}: Messages = ${JSON.stringify(data, null, 2)};\n`;
    // JSON.stringify escapes unicode fine; convert to TS-friendly (already valid)
    fs.writeFileSync(`src/shared/i18n/${loc}.ts`, out, "utf8");
    console.log("patched", loc);
  }
}

main().catch((e) => {
  console.error(e);
  process.exit(1);
});
